# ===========================================
# CONFIGURAÇÃO DO AMBIENTE — Lightning Backend
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# Encontre as variáveis no painel do Supabase: Settings > API / Database

# ─── Ambiente ───────────────────────────────
NODE_ENV=development
PORT=3333

# ─── Supabase: API ─────────────────────────
# Painel: Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Supabase: Banco de Dados ──────────────
# Painel: Settings > Database > Connection string > URI
#
# DATABASE_URL → usa o Pooler (porta 6543, modo transaction)
#   Para a aplicação em runtime.
#
# DIRECT_URL → conexão direta (porta 5432)
#   Para migrations (sequelize-cli db:migrate).
#
# Local (Docker): postgresql://spda_user:admin@localhost:5432/spda_db

DATABASE_URL=postgresql://postgres.SEU-REF:SUA-SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.SEU-REF:SUA-SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─── Autenticação JWT ──────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ALTERE_PARA_UM_SEGREDO_FORTE

# ─── Frontend (CORS) ──────────────────────
FRONTEND_URL=http://localhost:3000
